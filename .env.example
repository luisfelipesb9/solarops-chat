# SolarOps Chat: copie para .env (cp .env.example .env). O .env nunca vai para o git.

# Chave da OpenAI (cole a sua aqui; nunca commite)
OPENAI_API_KEY=
# Modelo barato; confirme com 'make check-llm'
OPENAI_MODEL=gpt-5.4-nano
# Opcional: minimal, low, medium ou high (vazio = não envia)
OPENAI_REASONING_EFFORT=

# Provedor do bot: openai ou fake (fake dispensa chave)
LLM_PROVIDER=openai
# Segundos por chamada à LLM
LLM_TIMEOUT=20
# Limite de tokens da resposta
LLM_MAX_OUTPUT_TOKENS=600

# FakeLLM: atraso em segundos (demo de timeout) e 1 para simular falha
FAKE_LLM_DELAY=0
FAKE_LLM_FAIL=0

# Mensagens guardadas por usuário no bot (3 trocas)
BOT_HISTORY_SIZE=6
# Timeout do servidor para BOT_REQ (deve ser maior que LLM_TIMEOUT)
BOT_TIMEOUT=30

# Certificados TLS (gere com 'make certs')
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key
TLS_CA=certs/ca.crt
